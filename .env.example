# =============================================================================
# Sendblue → Hermes Bridge Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ── Sendblue API credentials ──────────────────────────────────────────────────
# Get these from https://sendblue.co → Dashboard → API Keys
# Both the API Key ID and Secret Key are required.
SENDBLUE_API_KEY_ID=your_api_key_id_here
SENDBLUE_API_SECRET_KEY=your_api_secret_key_here

# Your Sendblue phone number (E.164 format, e.g. +14045551234)
# This is the number people will text to reach your Hermes agent.
SENDBLUE_FROM_NUMBER=+14045551234

# Webhook secret (only needed if switching to webhook mode — not required for polling)
SENDBLUE_WEBHOOK_SECRET=change_me_to_a_random_string

# ── Hermes API Bridge ─────────────────────────────────────────────────────────
# URL where the Hermes API bridge will listen (or is already running).
# Default: http://127.0.0.1:5000/v1
HERMES_API_SERVER_URL=http://127.0.0.1:5000/v1

# Shared secret for authenticating between the bridge and the API server.
# Generate with: openssl rand -hex 32
HERMES_API_SERVER_KEY=your_random_secret_here

# Port for the API bridge to listen on (default: 5000)
PORT=5000

# ── Optional: Override Hermes paths ──────────────────────────────────────────
# Only needed if Hermes is installed in a non-standard location.
# The bridge will auto-detect ~/.hermes/hermes-agent/venv/bin/python by default.
# HERMES_PYTHON=/path/to/hermes/venv/bin/python
# HERMES_HOME=~/.hermes